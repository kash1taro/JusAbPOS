<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- Windows authentication, default instance. For SQL Express use  Data Source=.\SQLEXPRESS  -->
    <add name="JusAbPOS"
         connectionString="Data Source=laugh-tough\sqlexpress;Initial Catalog=abejar;Integrated Security=True;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- Optional business details printed on receipts. Tax is a percentage (12 = 12%). -->
    <add key="BusinessName" value="JusAbPOS" />
    <add key="BusinessAddress" value="123 Main Street, City" />
    <add key="BusinessPhone" value="+1 555 0100" />
    <add key="TaxRatePercent" value="12" />
  </appSettings>
</configuration>
